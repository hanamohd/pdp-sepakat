<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuiz Interaktif RBT Tahun 5 - Reka Bentuk Pengaturcaraan</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Fredoka for friendly text) -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pastelRed: {
                            light: '#FFEBEE',
                            DEFAULT: '#EF9A9A',
                            dark: '#E57373',
                            border: '#EF5350'
                        },
                        pastelPurple: {
                            light: '#F3E5F5',
                            DEFAULT: '#CE93D8',
                            dark: '#B39DDB',
                            border: '#AB47BC'
                        }
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
            background: linear-gradient(135deg, #FFEBEE 0%, #F3E5F5 100%);
            touch-action: manipulation;
        }

        /* 3D Flip Card Effect */
        .card-container {
            perspective: 1000px;
        }
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        .card-container.flipped .card-inner {
            transform: rotateY(180deg);
        }
        .card-front, .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .card-front {
            background-color: #B39DDB;
            color: white;
            border: 3px solid #9C27B0;
        }
        .card-back {
            background-color: #ffffff;
            transform: rotateY(180deg);
            border: 3px solid #E57373;
        }
        .card-matched .card-back {
            background-color: #C8E6C9;
            border-color: #81C784;
        }

        /* Pulse animation */
        @keyframes pulse-grow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .pulse-btn {
            animation: pulse-grow 2s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-gray-800 select-none">

    <!-- Header Navigation -->
    <header class="bg-gradient-to-r from-pastelRed-dark to-pastelPurple-dark text-white py-4 px-6 shadow-md">
        <div class="max-w-5xl mx-auto flex justify-between items-center">
            <h1 class="text-2xl md:text-3xl font-bold tracking-wide flex items-center gap-2">
                <i class="fa-solid fa-robot text-yellow-300"></i> RBT TAHUN 5: PENGATURCARAAN
            </h1>
            <div id="playerBadge" class="hidden bg-white/20 px-4 py-1 rounded-full text-lg font-semibold border border-white/40">
                <i class="fa-solid fa-user text-yellow-300 mr-2"></i><span id="displayName">Pemain</span>
            </div>
        </div>
    </header>

    <!-- Main Dynamic Content Container -->
    <main class="flex-grow container mx-auto p-4 max-w-5xl flex items-center justify-center">
        
        <!-- 1. Halaman Muka Hadapan / Register -->
        <section id="startScreen" class="w-full max-w-lg bg-white rounded-3xl p-6 md:p-10 shadow-2xl border-4 border-pastelPurple-DEFAULT text-center">
            <div class="w-24 h-24 bg-pastelRed-light rounded-full mx-auto flex items-center justify-center text-pastelRed-dark text-5xl mb-4 border-4 border-pastelRed-dark">
                <i class="fa-solid fa-gamepad"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-pastelPurple-border mb-2">Kuiz Padanan & Minda!</h2>
            <p class="text-gray-600 text-lg mb-6">Padankan 2 gambar yang sama untuk membuka soalan. Jawab dengan betul untuk mengumpul markah tertinggi!</p>
            
            <form id="startForm" onsubmit="startGame(event)" class="space-y-5">
                <div class="text-left">
                    <label for="playerName" class="block text-lg font-semibold text-gray-700 mb-2">Nama Murid / Pemain:</label>
                    <input type="text" id="playerName" required placeholder="Masukkan nama penuh anda..." 
                        class="w-full px-5 py-4 text-xl rounded-2xl border-3 border-pastelPurple-dark focus:outline-none focus:ring-4 focus:ring-pastelPurple-DEFAULT text-gray-800 bg-pastelPurple-light/30">
                </div>
                <button type="submit" 
                    class="w-full py-4 text-2xl font-bold text-white bg-gradient-to-r from-pastelRed-dark to-pastelPurple-border rounded-2xl shadow-lg hover:brightness-105 active:scale-95 transition-transform pulse-btn">
                    MULA PERMAINAN <i class="fa-solid fa-play ml-2"></i>
                </button>
            </form>
        </section>

        <!-- 2. Ruangan Game Padanan (5 x 6 Grid) -->
        <section id="gameScreen" class="hidden w-full flex-col items-center">
            <!-- Game Bar Status -->
            <div class="w-full bg-white p-4 rounded-2xl shadow-md border-2 border-pastelRed-DEFAULT mb-4 flex justify-between items-center text-lg md:text-xl font-bold">
                <div class="text-pastelPurple-border flex items-center gap-2">
                    <i class="fa-solid fa-puzzle-piece text-2xl"></i>
                    <span>Pasangan: <span id="matchedCount" class="text-pastelRed-dark text-2xl">0</span> / 15</span>
                </div>
                <div class="text-pastelRed-dark flex items-center gap-2">
                    <i class="fa-solid fa-star text-yellow-400 text-2xl"></i>
                    <span>Markah: <span id="currentScore" class="text-2xl">0</span></span>
                </div>
            </div>

            <p class="text-center text-gray-700 text-lg mb-3 font-semibold bg-white/70 px-4 py-1 rounded-full border border-pastelPurple-DEFAULT">
                <i class="fa-solid fa-hand-pointer text-pastelRed-dark"></i> Klik 2 kad untuk mencari imej yang sama!
            </p>

            <!-- Memory Board: 5 x 6 Grid -->
            <div id="memoryBoard" class="grid grid-cols-5 gap-2 md:gap-3 w-full max-w-2xl aspect-[5/6] p-3 bg-white/80 rounded-2xl border-4 border-pastelPurple-dark shadow-xl">
                <!-- 30 Cards dynamically inserted here -->
            </div>
        </section>

        <!-- 3. Modal Popup Soalan -->
        <div id="questionModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
            <div class="bg-white rounded-3xl max-w-2xl w-full p-6 md:p-8 shadow-2xl border-4 border-pastelRed-dark transform transition-all scale-100 max-h-[90vh] overflow-y-auto">
                
                <!-- Modal Header -->
                <div class="flex justify-between items-center pb-3 border-b-2 border-gray-100 mb-4">
                    <span id="modalCategory" class="px-3 py-1 bg-pastelPurple-light text-pastelPurple-border font-bold rounded-full text-base border border-pastelPurple-DEFAULT">
                        Soalan 1
                    </span>
                    <span id="attemptBadge" class="px-3 py-1 bg-yellow-100 text-yellow-800 font-bold rounded-full text-sm">
                        Percubaan Pertama (2 Markah)
                    </span>
                </div>

                <!-- Text Soalan -->
                <h3 id="modalQuestionText" class="text-xl md:text-2xl font-bold text-gray-800 mb-6 leading-relaxed">
                    Teks soalan akan dipaparkan di sini...
                </h3>

                <!-- Ruangan Maklum Balas Peluang Kedua / Ralat -->
                <div id="feedbackBox" class="hidden mb-4 p-3 rounded-xl font-bold text-center text-lg"></div>

                <!-- Container Jawapan Dwi-Bentuk -->
                <div id="modalOptionsContainer" class="space-y-3 mb-6">
                    <!-- Dynamic option buttons -->
                </div>

                <!-- Footer Modal Action -->
                <div class="flex justify-end">
                    <button id="submitAnswerBtn" onclick="checkAnswer()" 
                        class="px-8 py-3 text-xl font-bold text-white bg-pastelRed-dark hover:bg-pastelRed-border rounded-xl shadow-md active:scale-95 transition-transform">
                        Hantar Jawapan <i class="fa-solid fa-paper-plane ml-1"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. Paparan Akhir & Dashboard Markah -->
        <section id="endScreen" class="hidden w-full max-w-3xl bg-white rounded-3xl p-6 md:p-10 shadow-2xl border-4 border-pastelPurple-dark text-center">
            <div class="w-24 h-24 bg-yellow-100 rounded-full mx-auto flex items-center justify-center text-yellow-500 text-5xl mb-4 border-4 border-yellow-300">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-pastelPurple-border mb-1">Tahniah, Permainan Tamat!</h2>
            <p class="text-gray-600 text-lg mb-4">Anda telah berjaya menyelesaikan kaji matapelajaran RBT Tahun 5.</p>

            <!-- Kad Keputusan Akhir -->
            <div class="bg-gradient-to-r from-pastelRed-light to-pastelPurple-light p-6 rounded-2xl border-2 border-pastelPurple-DEFAULT max-w-md mx-auto mb-8 shadow-inner">
                <p class="text-xl font-semibold text-gray-700">Nama Pemain: <span id="finalPlayerName" class="font-bold text-pastelPurple-border"></span></p>
                <div class="mt-2 text-4xl font-extrabold text-pastelRed-dark">
                    Markah Akhir: <span id="finalScoreDisplay">0</span> / 30
                </div>
            </div>

            <!-- Dashboard Senarai Nama & Markah -->
            <div class="mb-8 text-left">
                <h3 class="text-2xl font-bold text-gray-800 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-list-ol text-pastelRed-dark"></i> Papan Pendahulu (Dashboard):
                </h3>
                <div class="overflow-x-auto rounded-2xl border-2 border-pastelPurple-light shadow-sm">
                    <table class="w-full text-left bg-white text-lg">
                        <thead class="bg-pastelPurple-dark text-white">
                            <tr>
                                <th class="p-3">#</th>
                                <th class="p-3">Nama Pemain</th>
                                <th class="p-3 text-right">Markah Akhir</th>
                            </tr>
                        </thead>
                        <tbody id="leaderboardBody" class="divide-y divide-gray-100">
                            <!-- Leaderboard entries -->
                        </tbody>
                    </table>
                </div>
            </div>

            <button onclick="resetApp()" 
                class="px-8 py-4 text-2xl font-bold text-white bg-gradient-to-r from-pastelRed-dark to-pastelPurple-border rounded-2xl shadow-lg hover:brightness-105 active:scale-95 transition-transform">
                Main Semula <i class="fa-solid fa-rotate-right ml-2"></i>
            </button>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white/80 border-t border-gray-200 py-3 text-center text-gray-600 text-sm font-semibold">
        RBT Tahun 5 KSSR Semakan • Reka Bentuk Pengaturcaraan
    </footer>

    <!-- Game Logic Script -->
    <script>
        // Data 15 Imej / Pasangan (Ikon FontAwesome + Label RBT)
        const itemPairs = [
            { id: 1, label: "Atur Cara", icon: "fa-code" },
            { id: 2, label: "Pilihan", icon: "fa-code-branch" },
            { id: 3, label: "Ulangan", icon: "fa-arrows-rotate" },
            { id: 4, label: "Pseudokod", icon: "fa-file-lines" },
            { id: 5, label: "Carta Alir", icon: "fa-diagram-project" },
            { id: 6, label: "Mula / Tamat", icon: "fa-capsules" },
            { id: 7, label: "Proses", icon: "fa-square" },
            { id: 8, label: "Syarat", icon: "fa-diamond" },
            { id: 9, label: "Input / Output", icon: "fa-right-left" },
            { id: 10, label: "Mikropengawal", icon: "fa-microchip" },
            { id: 11, label: "Suis Tekan", icon: "fa-toggle-on" },
            { id: 12, label: "LED", icon: "fa-lightbulb" },
            { id: 13, label: "Pembaz", icon: "fa-volume-high" },
            { id: 14, label: "Motor Servo", icon: "fa-gear" },
            { id: 15, label: "Ralat", icon: "fa-bug" }
        ];

        // Bank 15 Soalan Dalam 4 Bentuk Berbeza (Ikut Sukatan RBT Tahun 5)
        const quizQuestions = [
            // --- BENTUK 1: PILIHAN GANDA 4 JAWAPAN (Soalan 1 - 5) ---
            {
                id: 1,
                type: "mcq",
                question: "Apakah fungsi utama struktur kawalan pilihan dalam pengaturcaraan?",
                options: [
                    "Melaksanakan langkah mengikut urutan lurus",
                    "Mempunyai dua atau lebih set tindakan sebagai pilihan",
                    "Mengulang tindakan sehingga syarat dipenuhi",
                    "Mengesan ralat dalam pengaturcaraan"
                ],
                answer: 1
            },
            {
                id: 2,
                type: "mcq",
                question: "Struktur kawalan ulangan jenis apakah yang dipelajari dalam unit RBT Tahun 5?",
                options: [
                    "SELAGI (WHILE)",
                    "UNTUK (FOR)",
                    "ULANGI (REPEAT)",
                    "JIKA (IF)"
                ],
                answer: 0
            },
            {
                id: 3,
                type: "mcq",
                question: "Perkataan utama yang digunakan dalam pseudokod bagi struktur kawalan pilihan ialah...",
                options: [
                    "SELAGI",
                    "JIKA",
                    "ULANG",
                    "MULA"
                ],
                answer: 1
            },
            {
                id: 4,
                type: "mcq",
                question: "Apakah komponen mikropengawal yang berfungsi mengeluarkan isyarat dalam bentuk bunyi?",
                options: [
                    "LED",
                    "Motor Servo",
                    "Pembaz",
                    "Perintang Tetap"
                ],
                answer: 2
            },
            {
                id: 5,
                type: "mcq",
                question: "Apakah peranti keluaran yang digunakan untuk membuat gerakan bersudut sehingga 360°?",
                options: [
                    "Motor Servo",
                    "Suis Tekan",
                    "Papan Reka",
                    "Kabel USB"
                ],
                answer: 0
            },

            // --- BENTUK 2: BETUL / SALAH (Soalan 6 - 10) ---
            {
                id: 6,
                type: "tf",
                question: "Adakah penyataan ini BETUL atau SALAH: 'Simbol bujong (Terminal) dalam carta alir digunakan untuk menunjukkan permulaan atau penamat.'",
                options: ["BETUL", "SALAH"],
                answer: 0
            },
            {
                id: 7,
                type: "tf",
                question: "Adakah penyataan ini BETUL atau SALAH: 'Ralat ialah kesilapan dalam algoritma yang menyebabkan output yang betul dihasilkan.'",
                options: ["BETUL", "SALAH"],
                answer: 1
            },
            {
                id: 8,
                type: "tf",
                question: "Adakah penyataan ini BETUL atau SALAH: 'Lampu isyarat menggunakan struktur kawalan ulangan untuk bertukar warna pada tempoh masa tertentu.'",
                options: ["BETUL", "SALAH"],
                answer: 0
            },
            {
                id: 9,
                type: "tf",
                question: "Adakah penyataan meletakkan perintang: 'Perintang digunakan untuk mengehadkan arus elektrik supaya komponen seperti LED tidak rosak.'",
                options: ["BETUL", "SALAH"],
                answer: 0
            },
            {
                id: 10,
                type: "tf",
                question: "Adakah penyataan ini BETUL atau SALAH: 'Perkataan MULA dan TAMAT boleh wujud berulang kali di dalam satu carta alir yang sama.'",
                options: ["BETUL", "SALAH"],
                answer: 1
            },

            // --- BENTUK 3: PADANKAN / URUTAN (Soalan 11 - 13) ---
            {
                id: 11,
                type: "order",
                question: "Pilih urutan yang BETUL bagi langkah asas menulis pseudokod:",
                options: [
                    "MULA ➔ Baca INPUT ➔ Proses Arahan ➔ Papar OUTPUT ➔ TAMAT",
                    "MULA ➔ Papar OUTPUT ➔ Baca INPUT ➔ TAMAT",
                    "Baca INPUT ➔ MULA ➔ Proses Arahan ➔ TAMAT",
                    "MULA ➔ Proses Arahan ➔ TAMAT ➔ Papar OUTPUT"
                ],
                answer: 0
            },
            {
                id: 12,
                type: "order",
                question: "Padankan fungsi perkakasan: Antara berikut, padanan manakah yang BENAR?",
                options: [
                    "Suis Tekan = Memutuskan dan menyambungkan litar elektrik",
                    "LED = Mengeluarkkan isyarat bunyi",
                    "Pembaz = Menghasilkan gerakan putaran",
                    "Papan Reka = Membekalkan voltan tinggi"
                ],
                answer: 0
            },
            {
                id: 13,
                type: "order",
                question: "Manakah padanan simbol carta alir yang BETUL?",
                options: [
                    "Rombus (Diamond) = Menguji Syarat / Pilihan",
                    "Segi Empat Tepat = Permulaan / Penamat",
                    "Oval = Memproses Input",
                    "Parallelogram = Mengatur Perintang"
                ],
                answer: 0
            },

            // --- BENTUK 4: PELBAGAI PILIHAN / ISIKAN KUNCI (Soalan 14 - 15) ---
            {
                id: 14,
                type: "fill",
                question: "Kawasan pada antara muka perisian pengaturcaraan berasaskan grafik yang digunakan untuk menempatkan blok atur cara dipanggil...",
                options: [
                    "Scripts Area",
                    "Blocks Palette",
                    "Stage Area",
                    "Sprite Library"
                ],
                answer: 0
            },
            {
                id: 15,
                type: "fill",
                question: "Apakah kaedah pemindahan atur cara ke papan mikropengawal apabila menggunakan fail bernombor format '.hex'?",
                options: [
                    "Kaedah Muat Turun, serta Tarik dan Lepas (Drag & Drop)",
                    "Kaedah Muat Naik Secara Imbasan QR",
                    "Kaedah Sambungan Bluetooth Sahaja",
                    "Kaedah Taip Semula Kunci"
                ],
                answer: 0
            }
        ];

        // State Aplikasi
        let currentPlayer = "";
        let currentScore = 0;
        let matchedPairs = 0;
        let flippedCards = [];
        let canFlip = true;
        
        let activeQuestionObj = null;
        let activePairId = null;
        let currentAttempt = 1; // 1 = Percubaan Pertama (2 markah), 2 = Percubaan Kedua (1 markah)
        let selectedOptionIndex = null;

        let leaderboard = [
            { name: "Aiman", score: 28 },
            { name: "Siti", score: 26 },
            { name: "Jonis", score: 24 }
        ];

        // Mula Permainan
        function startGame(e) {
            e.preventDefault();
            const inputName = document.getElementById("playerName").value.trim();
            if(!inputName) return;

            currentPlayer = inputName;
            document.getElementById("displayName").innerText = currentPlayer;
            document.getElementById("playerBadge").classList.remove("hidden");

            document.getElementById("startScreen").classList.add("hidden");
            document.getElementById("gameScreen").classList.remove("hidden");
            document.getElementById("gameScreen").classList.add("flex");

            initBoard();
        }

        // Penyediaan Board 5x6
        function initBoard() {
            const memoryBoard = document.getElementById("memoryBoard");
            memoryBoard.innerHTML = "";
            currentScore = 0;
            matchedPairs = 0;
            updateScoreBoard();

            // Duplikasi 15 item menjadi 30 kad
            let deck = [];
            itemPairs.forEach(item => {
                deck.push({ ...item });
                deck.push({ ...item });
            });

            // Shuffle
            deck.sort(() => Math.random() - 0.5);

            // Cipta Elemen Kad
            deck.forEach((cardData, index) => {
                const cardNode = document.createElement("div");
                cardNode.className = "card-container cursor-pointer w-full h-full";
                cardNode.dataset.pairId = cardData.id;
                cardNode.dataset.index = index;

                cardNode.innerHTML = `
                    <div class="card-inner w-full h-full">
                        <div class="card-front text-2xl md:text-3xl font-bold">
                            <i class="fa-solid fa-question"></i>
                        </div>
                        <div class="card-back flex-col gap-1 p-1 text-center">
                            <i class="fa-solid ${cardData.icon} text-2xl md:text-3xl text-pastelRed-dark"></i>
                            <span class="text-xs md:text-sm font-bold text-gray-700 leading-tight">${cardData.label}</span>
                        </div>
                    </div>
                `;

                cardNode.addEventListener("click", () => handleCardClick(cardNode));
                memoryBoard.appendChild(cardNode);
            });
        }

        // Logic Kad Dipilih
        function handleCardClick(card) {
            if (!canFlip) return;
            if (card.classList.contains("flipped") || card.classList.contains("card-matched")) return;

            card.classList.add("flipped");
            flippedCards.push(card);

            if (flippedCards.length === 2) {
                canFlip = false;
                const [card1, card2] = flippedCards;
                const pair1 = card1.dataset.pairId;
                const pair2 = card2.dataset.pairId;

                if (pair1 === pair2) {
                    // Berjaya Padan!
                    setTimeout(() => {
                        card1.classList.add("card-matched");
                        card2.classList.add("card-matched");
                        flippedCards = [];
                        canFlip = true;
                        
                        // Buka Soalan
                        openQuestionModal(parseInt(pair1));
                    }, 600);
                } else {
                    // Tidak Padan -> Pusing Semula
                    setTimeout(() => {
                        card1.classList.remove("flipped");
                        card2.classList.remove("flipped");
                        flippedCards = [];
                        canFlip = true;
                    }, 1000);
                }
            }
        }

        // Buka Popup Soalan
        function openQuestionModal(pairId) {
            activePairId = pairId;
            activeQuestionObj = quizQuestions.find(q => q.id === pairId);
            currentAttempt = 1;
            selectedOptionIndex = null;

            document.getElementById("modalCategory").innerText = `Soalan ${activeQuestionObj.id} daripada 15`;
            updateAttemptBadge();

            document.getElementById("modalQuestionText").innerText = activeQuestionObj.question;
            
            const feedbackBox = document.getElementById("feedbackBox");
            feedbackBox.classList.add("hidden");
            feedbackBox.className = "hidden mb-4 p-3 rounded-xl font-bold text-center text-lg";

            renderOptions();

            document.getElementById("questionModal").classList.remove("hidden");
        }

        function updateAttemptBadge() {
            const badge = document.getElementById("attemptBadge");
            if (currentAttempt === 1) {
                badge.className = "px-3 py-1 bg-yellow-100 text-yellow-800 font-bold rounded-full text-sm";
                badge.innerText = "Percubaan Pertama (2 Markah)";
            } else {
                badge.className = "px-3 py-1 bg-orange-100 text-orange-800 font-bold rounded-full text-sm";
                badge.innerText = "Peluang Kedua (1 Markah)";
            }
        }

        // Paparkan Pilihan Jawapan
        function renderOptions() {
            const container = document.getElementById("modalOptionsContainer");
            container.innerHTML = "";

            activeQuestionObj.options.forEach((optText, idx) => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "w-full text-left px-5 py-4 rounded-2xl text-lg md:text-xl font-semibold border-3 border-gray-200 bg-gray-50 hover:bg-pastelPurple-light hover:border-pastelPurple-dark transition-all flex items-center justify-between";
                
                btn.innerHTML = `
                    <span>${optText}</span>
                    <i class="fa-regular fa-circle text-gray-400 text-xl check-icon"></i>
                `;

                btn.onclick = () => {
                    // Highlight selected
                    Array.from(container.children).forEach(c => {
                        c.className = "w-full text-left px-5 py-4 rounded-2xl text-lg md:text-xl font-semibold border-3 border-gray-200 bg-gray-50 hover:bg-pastelPurple-light hover:border-pastelPurple-dark transition-all flex items-center justify-between";
                        c.querySelector('.check-icon').className = "fa-regular fa-circle text-gray-400 text-xl check-icon";
                    });

                    btn.className = "w-full text-left px-5 py-4 rounded-2xl text-lg md:text-xl font-semibold border-3 border-pastelPurple-border bg-pastelPurple-light text-pastelPurple-border transition-all flex items-center justify-between shadow-md";
                    btn.querySelector('.check-icon').className = "fa-solid fa-circle-check text-pastelPurple-border text-xl check-icon";
                    
                    selectedOptionIndex = idx;
                };

                container.appendChild(btn);
            });
        }

        // Semak Jawapan & Sistem Markah
        function checkAnswer() {
            if (selectedOptionIndex === null) {
                alert("Sila pilih satu jawapan terlebih dahulu!");
                return;
            }

            const feedbackBox = document.getElementById("feedbackBox");
            const isCorrect = (selectedOptionIndex === activeQuestionObj.answer);

            if (isCorrect) {
                // Jawapan Betul
                const markAwarded = (currentAttempt === 1) ? 2 : 1;
                currentScore += markAwarded;
                updateScoreBoard();

                feedbackBox.classList.remove("hidden");
                feedbackBox.classList.add("bg-green-100", "text-green-800", "border-2", "border-green-400");
                feedbackBox.innerHTML = `<i class="fa-solid fa-circle-check mr-2"></i>Syabas! Jawapan anda BETUL (+${markAwarded} Markah)`;

                disableModalActions();

                setTimeout(() => {
                    closeQuestionModal();
                }, 1400);

            } else {
                // Jawapan Salah
                if (currentAttempt === 1) {
                    // Bagi Peluang Kedua
                    currentAttempt = 2;
                    updateAttemptBadge();

                    feedbackBox.classList.remove("hidden");
                    feedbackBox.classList.add("bg-red-100", "text-red-800", "border-2", "border-red-400");
                    feedbackBox.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-2"></i>Jawapan kurang tepat. Cuba sekali lagi untuk (1 Markah)!`;

                    selectedOptionIndex = null;
                    renderOptions();
                } else {
                    // Salah Percubaan Kedua (0 Markah)
                    feedbackBox.classList.remove("hidden");
                    feedbackBox.classList.add("bg-gray-100", "text-gray-800", "border-2", "border-gray-400");
                    feedbackBox.innerHTML = `<i class="fa-solid fa-circle-xmark mr-2"></i>Minta maaf, jawapan masih tidak tepat (0 Markah).`;

                    disableModalActions();

                    setTimeout(() => {
                        closeQuestionModal();
                    }, 1400);
                }
            }
        }

        function disableModalActions() {
            document.getElementById("submitAnswerBtn").disabled = true;
            document.getElementById("submitAnswerBtn").classList.add("opacity-50", "cursor-not-allowed");
            const options = document.getElementById("modalOptionsContainer").children;
            for(let opt of options) {
                opt.onclick = null;
            }
        }

        function closeQuestionModal() {
            document.getElementById("questionModal").classList.add("hidden");
            document.getElementById("submitAnswerBtn").disabled = false;
            document.getElementById("submitAnswerBtn").classList.remove("opacity-50", "cursor-not-allowed");

            matchedPairs++;
            document.getElementById("matchedCount").innerText = matchedPairs;

            // Semak jika semua 15 soalan selasai
            if (matchedPairs === 15) {
                setTimeout(() => {
                    showEndScreen();
                }, 500);
            }
        }

        function updateScoreBoard() {
            document.getElementById("currentScore").innerText = currentScore;
        }

        // Tunjukkan Dashboard & Skrin Akhir
        function showEndScreen() {
            document.getElementById("gameScreen").classList.add("hidden");
            document.getElementById("gameScreen").classList.remove("flex");

            document.getElementById("endScreen").classList.remove("hidden");

            document.getElementById("finalPlayerName").innerText = currentPlayer;
            document.getElementById("finalScoreDisplay").innerText = currentScore;

            // Masukkan ke Dashboard / Leaderboard
            leaderboard.push({ name: currentPlayer, score: currentScore });
            leaderboard.sort((a, b) => b.score - a.score);

            const tbody = document.getElementById("leaderboardBody");
            tbody.innerHTML = "";
            leaderboard.forEach((entry, idx) => {
                const tr = document.createElement("tr");
                tr.className = (entry.name === currentPlayer) ? "bg-yellow-50 font-bold" : "";
                tr.innerHTML = `
                    <td class="p-3">${idx + 1}</td>
                    <td class="p-3">${entry.name} ${entry.name === currentPlayer ? '<span class="text-xs bg-pastelRed-dark text-white px-2 py-0.5 rounded-full ml-1">ANDA</span>' : ''}</td>
                    <td class="p-3 text-right font-bold text-pastelPurple-border">${entry.score} / 30</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Reset Aplikasi
        function resetApp() {
            document.getElementById("endScreen").classList.add("hidden");
            document.getElementById("startScreen").classList.remove("hidden");
            document.getElementById("playerName").value = "";
            document.getElementById("playerBadge").classList.add("hidden");
        }
    </script>
</body>
</html>
